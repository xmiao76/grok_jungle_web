{
  "name": "grok-jungle-web",
  "version": "1.0.0",
  "private": true,
  "description": "Jungle (Dou Shou Qi) in the browser — grok_jungle Python engine on Pyodide, deployed to Cloudflare Pages",
  "type": "module",
  "scripts": {
    "sync": "node tools/sync-engine.mjs",
    "assets": "python tools/prep-assets.py",
    "dev": "node tools/serve.mjs",
    "test:py": "python -m pytest",
    "test:js": "node --test tests/js/*.test.mjs",
    "test:pyodide": "node tests/pyodide/smoke.mjs",
    "test:e2e": "playwright test",
    "deploy": "wrangler pages deploy public --project-name grok-jungle"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "pyodide": "0.27.7",
    "wrangler": "^4.20.0"
  }
}
